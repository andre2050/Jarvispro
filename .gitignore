# 3.8 — auditoria de decisões, missões, grafo de conhecimento e rede de NEXUS (chaves dos pares!)
memory/auditoria.jsonl
memory/missoes/
memory/grafo.json
memory/rede_backup/
config/rede_nexus.json
config/agentes.json
config/hibrido.json
plugins_gerados/
