# ── NEXUS — what never belongs in the repository ──────────────────────────
# Everything listed here is created by the app on first run. A fresh clone with
# none of it present boots straight to the setup screen, which is the intended
# first experience — so nothing here needs to be committed, and some of it must
# never be.

# ── Secrets. Committing any of these publishes them. ──────────────────────────
# your Gemini API key, plus per-plugin credentials
config/api_keys.json
# a licença ativada neste PC
config/licenca.json
# the dashboard's TLS private key and certificate
config/certs/
# a LINKED WhatsApp session — committing it hands somebody your WhatsApp account, not just a key
config/whatsapp_web/
# Google OAuth tokens (Gmail / Calendar plugins)
**/token*.json
# Google OAuth client secrets
**/client_secret*.json
*credentials*.json
.env
.env.*

# ── Personal data the assistant accumulates about you ─────────────────────────
memory/long_term.json
memory/*.db
memory/facts.json
memory/conversations.json
memory/routines.json
memory/reminders.json
memory/organizacao_desktop*.json
memory/habits.json
memory/projetos.json
memory/update_state.json
memory/price_alerts.json
# 3.4 — bem-estar, vigias, tempo de projeto, núcleo I.S.A. (medidas, reparos e cópias boas)
memory/bemestar.json
memory/vigias.json
memory/tempo_projetos.json
memory/isa_series.json
memory/regeneracao.json
memory/regeneracao_copias/
memory/routines_sementes.json
config/quick_notes.json
config/focus_state.json
config/email_account.json
memory/intent_examples.json
memory/intent_net.npz
memory/intent_net_settings.json
*.key
*.pem

# ── Python build noise ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Editors and operating systems ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ── Runtime output ────────────────────────────────────────────────────────────
# downloaded/dropped update packages (big zips)
updates/
# copies made before each update (for rollback)
backups/
*.part
*.log
logs/
downloads/
screenshots/

# ── Email reader state (which message was last read aloud) ────────────────────
memory/email_state.json

# ── 2.1 — mais dados pessoais que o NEXUS guarda (finanças, tarefas, casa, pastas) ──
config/finance_entries.json
config/finance_budgets.json
config/casa.json
config/folder_watch.json
config/facts.json
config/shortcut_catalog.json
memory/tarefas.json
memory/compras.json
memory/habitos_diarios.json
memory/contatos.json
memory/diario.json
memory/*.quebrado
memory/*.desfeito.json
memory/audit.log*
erro_ao_abrir.txt
uploads/

# ── Caches de ferramentas ──
.ruff_cache/
.pytest_cache/
.mypy_cache/

# ── Nexus.exe (gerado por gerar_exe.bat no seu PC) ──
Nexus.exe
_internal/
build/
dist/

# ── 2.3 — voz, rostos, métricas e modelos ficam só no seu PC ──
memory/voz_dono.npz
memory/voz_dono.json
memory/wake_nexus.npz
memory/indice_semantico.npz
memory/reconexoes.log
memory/falhas.log
memory/queda_nativa.log
memory/sessao.json
memory/metricas.csv
memory/anomalia.json
memory/previsao_habitos.json
memory/rostos.npz
memory/modelos/
memory/cerebro_local/
